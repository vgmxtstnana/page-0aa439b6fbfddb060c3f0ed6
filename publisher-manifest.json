us);padding:28px;display:flex;flex-direction:column;gap:18px;box-shadow:var(--shadow)}\n.panel h2{font-size:14px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}\n.panel-row{display:flex;justify-content:space-between;align-items:center;border-bottom:1px dashed var(--line-soft);padding:10px 0;font-size:14px}\n.panel-row:last-child{border-bottom:none}\n.panel-row b{color:var(--acid);font-weight:600}\n.panel-pill{display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--ink);background:var(--acid);padding:4px 12px;border-radius:999px;font-weight:600;align-self:flex-start}\n.panel-cta{margin-top:auto;background:var(--acid);color:var(--ink);text-align:center;padding:16px 20px;border-radius:14px;font-weight:700;font-size:15px;letter-spacing:.06em}\n\n/* SECTION */\nsection{margin-top:72px}\n.sec-head{display:flex;align-items:baseline;justify-content:space-between;border-bottom:1px solid var(--line-soft);padding-bottom:18px;margin-bottom:36px;flex-wrap:wrap;gap:12px}\n.sec-head h2{font-size:28px;letter-spacing:-.01em;font-weight:700}\n.sec-head h2 small{display:block;font-size:12px;letter-spacing:.24em;color:var(--muted);text-transform:uppercase;margin-bottom:8px}\n.sec-head p{color:var(--muted);font-size:13px;max-width:36ch;text-align:right}\n\n/* INFO GRID (left big + right cards) */\n.info-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:28px}\n.lead-card{background:#10151a;border:1px solid var(--line-soft);border-radius:var(--radius);padding:34px;box-shadow:var(--shadow)}\n.lead-card h3{font-size:24px;line-height:1.3;margin-bottom:14px;font-weight:700}\n.lead-card h3 b{color:var(--acid);font-weight:700}\n.lead-card p{color:#c4ccc5;font-size:15px;margin-bottom:12px}\n.kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}\n.kpi{background:#0c1115;border-radius:14px;padding:16px;border:1px solid var(--line)}\n.kpi b{display:block;font-size:28px;color:var(--acid);font-weight:700;letter-spacing:-.02em}\n.kpi span{color:var(--muted);font-size:12px;letter-spacing:.04em}\n\n.sub-cards{display:grid;grid-template-columns:1fr 1fr;gap:20px}\n.sub{background:#10151a;border:1px solid var(--line-soft);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow)}\n.sub h4{font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}\n.sub p{font-size:14px;color:#c4ccc5}\n\n/* HOW IT WORKS */\n.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.step{background:#10151a;border:1px solid var(--line-soft);border-radius:var(--radius);padding:24px;position:relative;overflow:hidden;box-shadow:var(--shadow)}\n.step .no{font-size:62px;font-weight:800;color:#1d2326;letter-spacing:-.04em;position:absolute;right:-6px;bottom:-18px;line-height:1}\n.step h4{font-size:16px;margin-bottom:10px;color:var(--acid);font-weight:700;position:relative;z-index:1}\n.step p{font-size:13px;color:#c4ccc5;position:relative;z-index:1}\n\n/* PLANS TABLE */\n.table-wrap{background:#10151a;border:1px solid var(--line-soft);border-radius:var(--radius);padding:14px;overflow:auto;box-shadow:var(--shadow)}\ntable{width:100%;border-collapse:separate;border-spacing:0;min-width:680px}\nthead th{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);text-align:left;padding:18px 20px;border-bottom:1px solid var(--line-soft)}\nthead th.feat{width:32%}\ntbody td{padding:18px 20px;border-bottom:1px solid var(--line-soft);font-size:14px;color:#c4ccc5;vertical-align:top}\ntbody tr:last-child td{border-bottom:none}\ntbody td.name{font-weight:700;color:var(--paper);font-size:15px}\ntbody td.price{color:var(--acid);font-weight:700;font-size:18px}\ntbody td.price small{display:block;color:var(--muted);font-size:11px;font-weight:500;margin-top:4px;letter-spacing:.04em}\ntbody td.feat-h b{color:var(--acid);font-weight:600;display:block;margin-bottom:6px}\ntbody td.feat-h span{display:inline-block;background:#1a2125;color:#d6dcd3;font-size:12px;padding:4px 10px;border-radius:999px;margin:3px 4px 0 0}\n.tag-hot{display:inline-block;background:var(--acid);color:var(--ink);font-size:11px;padding:3px 8px;border-radius:6px;font-weight:700;letter-spacing:.04em;margin-left:6px;vertical-align:middle}\n\n/* CLIENTS */\n.clients{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n.client{background:#10151a;border:1px solid var(--line-soft);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow)}\n.client .plat{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}\n.client h4{font-size:18px;margin-bottom:8px;font-weight:700}\n.client p{font-size:13px;color:#c4ccc5;margin-bottom:18px}\n.client ul{list-style:none;display:grid;gap:6px;margin-bottom:18px}\n.client li{font-size:13px;color:#d6dcd3;padding-left:14px;position:relative}\n.client li::before{content:\"\";position:absolute;left:0;top:9px;width:6px;height:6px;border-radius:50%;background:var(--acid)}\n.client .dl{display:inline-block;background:#0c1115;border:1px solid var(--acid);color:var(--acid);padding:9px 16px;border-radius:10px;font-size:13px;font-weight:600}\n\n/* FAQ */\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}\n.faq{background:#10151a;border:1px solid var(--line-soft);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow)}\n.faq h4{font-size:16px;color:var(--acid);margin-bottom:12px;font-weight:700}\n.faq p{font-size:13.5px;color:#c4ccc5}\n\n/* FOOT */\nfooter{margin-top:80px;padding-top:32px;border-top:1px solid var(--line-soft);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;font-size:13px;color:var(--muted)}\nfooter .acid{color:var(--acid)}\nfooter a{color:#d6dcd3;margin-left:18px}\n\n@media (max-width:960px){\nbody{padding:20px 5vw 60px}\n.hero{padding:32px 24px}\n.hero-grid{grid-template-columns:1fr}\n.info-grid{grid-template-columns:1fr}\n.sub-cards{grid-template-columns:1fr}\n.steps{grid-template-columns:1fr 1fr}\n.clients{grid-template-columns:1fr}\n.faq-grid{grid-template-columns:1fr}\n.hero-meta{gap:6px}\n}\n@media (max-width:520px){\n.steps{grid-template-columns:1fr}\n.kpi-row{grid-template-columns:1fr 1fr}\n}\n</style><div class=\"wrap\">\n\n<header class=\"hero\" id=\"top\">\n<div class=\"hero-grid\">\n<div>\n<h1><span>叉烧云</span><br><span class=\"acid\">订阅一次，</span><br><span class=\"strike\">全设备接管。</span></h1>\n<p class=\"hero-lead\">叉烧云把节点订阅、线路分流和设备管理整合成一套轻量的服务面板。你拿到手的是一条可复制的链接和一份看得懂的账单，剩下的由线路本身去跑。</p>\n<div class=\"hero-meta\">\n<span>节点线路 <b>多协议</b></span>\n<span>设备端 <b>5 台起</b></span>\n<span>计费方式 <b>月 / 年</b></span>\n<span>状态 <b>正在营业</b></span>\n</div>\n<div class=\"hero-anchor\">\n<a href=\"#about\">关于服务</a>\n<a href=\"#flow\">使用流程</a>\n<a href=\"#plans\">套餐对比</a>\n<a href=\"#client\">客户端</a>\n<a href=\"#faq\">常见问题</a>\n</div>\n</div>\n<aside class=\"panel\">\n<span class=\"panel-pill\">● 实时面板</span>\n<h2>核心信息一栏</h2>\n<div class=\"panel-row\"><span>订阅协议</span><b>SS / VLESS / Trojan</b></div>\n<div class=\"panel-row\"><span>设备并发</span><b>3 — 20 台</b></div>\n<div class=\"panel-row\"><span>流量梯度</span><b>100G / 300G / 1000G</b></div>\n<div class=\"panel-row\"><span>计费周期</span><b>月付 · 年付</b></div>\n<div class=\"panel-row\"><span>优先级队列</span><b>基础 / 优先 / VIP</b></div>\n<div class=\"panel-row\"><span>服务形态</span><b>纯线上运营</b></div>\n<div class=\"panel-cta\">前往套餐对比 →</div>\n</aside>\n</div>\n</header>\n\n<section id=\"about\">\n<div class=\"sec-head\">\n<h2><small>01 — 了解服务</small>关于叉烧云</h2>\n<p>一段简介，两句要点，三项约束。</p>\n</div>\n<div class=\"info-grid\">\n<article class=\"lead-card\">\n<h3>我们只做<b>订阅与线路</b>这一件事。</h3>\n<p>叉烧云不打算做成大而全的网络工具，我们更愿意把节点、订阅链接、流量统计和客户端安装指引放在同一块屏幕上。用户进门就能看到价格、流量、设备数和节点标签，不需要点三层菜单。</p>\n<p>每条线路都配有一份可读的说明，写清协议、适用人群和注意事项。我们相信看得见的参数比一句“极速稳定”更接近事实。</p>\n<p>如果你正在找一个偏安静、偏克制的服务入口，叉烧云可以作为一个参考。</p>\n<div class=\"kpi-row\">\n<div class=\"kpi\"><b>3</b><span>套餐档位</span></div>\n<div class=\"kpi\"><b>5+</b><span>客户端支持</span></div>\n<div class=\"kpi\"><b>0</b><span>捆绑广告</span></div>\n</div>\n</article>\n<div class=\"sub-cards\">\n<div class=\"sub\">\n<h4>不做的事</h4>\n<p>不强制注册多个账号，不索要手机号和实名信息，不会把订阅链接交给第三方分发。所有账单一律在站内查看。</p>\n</div>\n<div class=\"sub\">\n<h4>做好的事</h4>\n<p>把订阅信息、客户端下载、流量计数和续费入口放进同一个面板，让你能用最少的步骤拿到节点并完成切换。</p>\n</div>\n<div class=\"sub\">\n<h4>价格透明</h4>\n<p>月付与年付价格写在一起，续费按当前页面显示金额结算，不存在隐藏的“首月优惠”。</p>\n</div>\n<div class=\"sub\">\n<h4>设备友好</h4>\n<p>提供手机、电脑和路由器三个场景的客户端说明，每种客户端都附一段图文指引，不让用户自己摸索。</p>\n</div>\n</div>\n</div>\n</section>\n\n<section id=\"flow\">\n<div class=\"sec-head\">\n<h2><small>02 — 使用流程</small>从注册到切换节点的四步</h2>\n<p>每步不超过一分钟能看懂。</p>\n</div>\n<div class=\"steps\">\n<div class=\"step\">\n<span class=\"no\">01</span>\n<h4>挑选套餐</h4>\n<p>在套餐页对照月付和年付价格，按流量与设备数确定档位；确认后复制订阅链接。</p>\n</div>\n<div class=\"step\">\n<span class=\"no\">02</span>\n<h4>下载客户端</h4>\n<p>根据设备类型选择对应客户端，按页面上的安装步骤操作，不需要配置额外参数。</p>\n</div>\n<div class=\"step\">\n<span class=\"no\">03</span>\n<h4>导入订阅</h4>\n<p>把订阅链接粘贴到客户端的“订阅”字段，刷新一次即可拉取当前套餐下的全部节点。</p>\n</div>\n<div class=\"step\">\n<span class=\"no\">04</span>\n<h4>开始使用</h4>\n<p>挑选一个延迟较低的节点启用，流量统计会在套餐页同步更新，可随时查看剩余量。</p>\n</div>\n</div>\n</section>\n\n<section id=\"plans\">\n<div class=\"sec-head\">\n<h2><small>03 — 套餐</small>横向对比三档套餐</h2>\n<p>直接看差异，不靠形容词。</p>\n</div>\n<div class=\"table-wrap\">\n<table>\n<thead>\n<tr>\n<th class=\"feat\">套餐权益</th>\n<th>基础版</th>\n<th>旗舰版<span class=\"tag-hot\">推荐</span></th>\n<th>团队版</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td class=\"feat-h\"><b>月付价格</b><span>按月结算，可随时取消</span></td>\n<td class=\"price\">¥15/月<small>年付 ¥150/年</small></td>\n<td class=\"price\">¥35/月<small>年付 ¥350/年</small></td>\n<td class=\"price\">¥85/月<small>年付 ¥850/年</small></td>\n</tr>\n<tr>\n<td class=\"feat-h\"><b>每月流量</b><span>超额后限速</span></td>\n<td class=\"feat-h\">100GB 流量额度</td>\n<td class=\"feat-h\">300GB 流量额度</td>\n<td class=\"feat-h\">1000GB 流量额度</td>\n</tr>\n<tr>\n<td class=\"feat-h\"><b>同时在线</b><span>设备并发数</span></td>\n<td>3 台设备</td>\n<td>5 台设备</td>\n<td>20 台设备</td>\n</tr>\n<tr>\n<td class=\"feat-h\"><b>流媒体</b><span>平台解锁情况</span></td>\n<td>基础流媒体解锁</td>\n<td>全节点原生解锁</td>\n<td>全节点原生解锁</td>\n</tr>\n<tr>\n<td class=\"feat-h\"><b>线路池</b><span>节点来源说明</span></td>\n<td>普通线路节点池</td>\n<td>含 IPLC 专线游戏加速优化</td>\n<td>含 VIP 专属高带宽节点</td>\n</tr>\n<tr>\n<td class=\"feat-h\"><b>支持通道</b><span>咨询与工单</span></td>\n<td>邮箱工单</td>\n<td>7×24 优先工单支持</td>\n<td>专属客户经理服务</td>\n</tr>\n<tr>\n<td class=\"feat-h\"><b>定制项</b><span>套餐内可叠加</span></td>\n<td>—</td>\n<td>—</td>\n<td>支持企业定制路由</td>\n</tr>\n</tbody>\n</table>\n</div>\n</section>\n\n<section id=\"client\">\n<div class=\"sec-head\">\n<h2><small>04 — 客户端</small>设备与第三方工具</h2>\n<p>按常见设备分组，找一个能用的就行。</p>\n</div>\n<div class=\"clients\">\n<article class=\"client\">\n<div class=\"plat\">DESKTOP</div>\n<h4>桌面系统</h4>\n<p>适用于 Windows 与 macOS 的图形化客户端，复制订阅链接后即可一键拉取节点。</p>\n<ul>\n<li>支持协议：SS / VLESS / Trojan</li>\n<li>导入方式：订阅链接 / 二维码</li>\n<li>系统路由：可手动开关</li>\n</ul>\n<a class=\"dl\" href=\"#\">查看桌面端说明</a>\n</article>\n<article class=\"client\">\n<div class=\"plat\">MOBILE</div>\n<h4>移动设备</h4>\n<p>iOS 与 Android 客户端在首次启动时需要允许添加 VPN 配置，按提示授权即可。</p>\n<ul>\n<li>订阅刷新：下拉立即更新</li>\n<li>节点分组：自动按地区归类</li>\n<li>分流规则：内置常见列表</li>\n</ul>\n<a class=\"dl\" href=\"#\">查看移动端说明</a>\n</article>\n<article class=\"client\">\n<div class=\"plat\">ROUTER / OPENWRT</div>\n<h4>路由器固件</h4>\n<p>提供可在 OpenWrt 与常见第三方固件上直接导入的订阅脚本，适合需要长期挂机的场景。</p>\n<ul>\n<li>运行方式：本地订阅脚本</li>\n<li>失败回退：保留上一份节点</li>\n<li>流量统计：通过订阅接口同步</li>\n</ul>\n<a class=\"dl\" href=\"#\">查看路由器端说明</a>\n</article>\n</div>\n</section>\n\n<section id=\"faq\">\n<div class=\"sec-head\">\n<h2><small>05 — 常见问题</small>FAQ 双栏速查</h2>\n<p>选两个最关心的问题往下翻。</p>\n</div>\n<div class=\"faq-grid\">\n<article class=\"faq\">\n<h4>订阅链接会不会被泄露？</h4>\n<p>订阅链接只对订阅者本人可见，刷新后会重新生成加密串。我们不会把链接写入邮件正文，也不会出现在搜索引擎快照里。建议拿到链接后立即复制到本地客户端，不要再二次转发。</p>\n</article>\n<article class=\"faq\">\n<h4>套餐之间可以随时切换吗？</h4>\n<p>可以。月付套餐在当前周期结束前升级到更高档位，差价按剩余天数折算；降到更低的档位则在下一周期生效。年付套餐到期前 7 天可选择续费或换档。</p>\n</article>\n<article class=\"faq\">\n<h4>流量用完会怎样？</h4>\n<p>套餐流量用尽后，节点会进入限速状态，带宽压低到不影响在线但不便于高码率观看。下个月度周期重新计算额度，也可以手动购买加油包恢复全速。</p>\n</article>\n<article class=\"faq\">\n<h4>支持哪些支付方式？</h4>\n<p>站内默认列出常用的在线支付渠道，具体可用方式以下单页面提示为准。若需要企业抬头，可在订单页备注开票信息，由客户经理统一跟进。</p>\n</article>\n<article class=\"faq\">\n<h4>订阅能否多人共用？</h4>\n<p>同一份订阅按账号并发设备数计费。多人共用请使用团队版套餐，或各自注册独立账号以避免互相挤占流量额度。</p>\n</article>\n<article class=\"faq\">\n<h4>遇到节点连不上怎么办？</h4>\n<p>先在客户端里手动刷新一次订阅，再切换到另一个节点的延迟测试；若仍不可用，请通过套餐内的支持通道提交工单，写明节点名称和报错截图。</p>\n</article>\n</div>\n</section>\n\n<footer>\n<div>© <span class=\"acid\">叉烧云</span> — 节点订阅与线路服务</div>\n<div><a href=\"#top\">回到顶部</a><a href=\"#plans\">套餐</a><a href=\"#faq\">FAQ</a></div>\n</footer>\n\n</div></main>",
